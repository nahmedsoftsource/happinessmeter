<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MoodTracking.Api</RootNamespace>
    <AssemblyName>MoodTracking.Api</AssemblyName>
    <Description>ASP.NET Core Web API for HappinessMeter mood tracking</Description>
    <Authors>HappinessMeter Team</Authors>
    <Version>1.0.0</Version>
    <UserSecretsId>moodtracking-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.0" />

    <!-- OpenAPI/Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />

    <!-- Rate Limiting (built-in in .NET 7+) -->

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoodTracking.Shared\MoodTracking.Shared.csproj" />
    <ProjectReference Include="..\MoodTracking.Infrastructure\MoodTracking.Infrastructure.csproj" />
  </ItemGroup>

</Project>
