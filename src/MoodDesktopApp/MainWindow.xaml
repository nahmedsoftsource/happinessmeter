<Window x:Class="MoodDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MoodDesktopApp.ViewModels"
        mc:Ignorable="d"
        Title="MoodTrack"
        Height="480" Width="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#F0F0F0"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Greeting -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Greeting}"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#212121"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,10"/>

        <!-- Question -->
        <TextBlock Grid.Row="1"
                   Text="How are you feeling?"
                   FontSize="18"
                   Foreground="#757575"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <!-- Status Message -->
        <Border Grid.Row="2"
                Background="#FFF8E1"
                CornerRadius="8"
                Padding="15,10"
                Margin="0,0,0,15"
                BorderBrush="#FFE082"
                BorderThickness="1"
                HorizontalAlignment="Center"
                Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9200;" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center" Foreground="#5D4037"/>
            </StackPanel>
        </Border>

        <!-- Mood Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowMoodButtons, Converter={StaticResource BoolToVisibilityConverter}}">

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding SoHappyBackground}"
                    BorderBrush="{Binding SoHappyBorder}"
                    BorderThickness="{Binding SoHappyBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="SoHappy"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#128513;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="So Happy" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding VeryBusyBackground}"
                    BorderBrush="{Binding VeryBusyBorder}"
                    BorderThickness="{Binding VeryBusyBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="VeryBusy"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#129489;&#8205;&#128187;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Very Busy" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding PositiveEnergyBackground}"
                    BorderBrush="{Binding PositiveEnergyBorder}"
                    BorderThickness="{Binding PositiveEnergyBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="PositiveEnergy"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#9889;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Positive Energy" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding NotInMoodBackground}"
                    BorderBrush="{Binding NotInMoodBorder}"
                    BorderThickness="{Binding NotInMoodBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="NotInMood"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#128532;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Not in Mood" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding HungryBackground}"
                    BorderBrush="{Binding HungryBorder}"
                    BorderThickness="{Binding HungryBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="Hungry"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#127828;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hungry" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding GrumpyBackground}"
                    BorderBrush="{Binding GrumpyBorder}"
                    BorderThickness="{Binding GrumpyBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="Grumpy"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#129314;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Grumpy" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MoodButtonStyle}"
                    Background="{Binding SleepyBackground}"
                    BorderBrush="{Binding SleepyBorder}"
                    BorderThickness="{Binding SleepyBorderThickness}"
                    Command="{Binding SelectMoodCommand}"
                    CommandParameter="Sleepy"
                    IsEnabled="{Binding CanSelectMood}">
                <StackPanel>
                    <TextBlock Text="&#128564;" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sleepy" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,15"
                    Visibility="{Binding ShowMoodButtons, Converter={StaticResource BoolToVisibilityConverter}}">

            <Button Style="{StaticResource ActionButtonStyle}"
                    Background="#2196F3"
                    Content="Save and Close"
                    Command="{Binding SaveAndCloseCommand}"
                    IsEnabled="{Binding HasSelectedMood}"
                    Margin="0,0,15,0"/>

            <Button Style="{StaticResource ActionButtonStyle}"
                    Background="#EF5350"
                    Content="Clear"
                    Command="{Binding ClearSelectionCommand}"
                    IsEnabled="{Binding HasSelectedMood}"/>
        </StackPanel>

        <!-- Selected Mood Display -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasSelectedMood, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Selected: " FontSize="14" Foreground="#757575" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedMoodDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#212121" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedMoodEmoji}" FontSize="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Confirmation Message -->
        <StackPanel Grid.Row="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="&#10004;" FontSize="48" Foreground="#4CAF50" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ConfirmationMessage}"
                       FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#424242" Margin="20,10,20,0" MaxWidth="500"/>
        </StackPanel>

        <!-- Loading Indicator -->
        <StackPanel Grid.Row="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
            <TextBlock Text="Saving..." FontSize="14" Foreground="#757575" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
