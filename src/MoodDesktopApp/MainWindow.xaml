<Window x:Class="MoodDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MoodDesktopApp.ViewModels"
        mc:Ignorable="d"
        Title="HappinessMeter"
        Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="15"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#F5F5F5" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="HappinessMeter"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#424242"/>

                <Button Grid.Column="1"
                        Content="X"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#757575"
                        FontWeight="Bold"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Question -->
            <StackPanel Grid.Row="1" Margin="20,25,20,15">
                <TextBlock Text="{Binding Greeting}"
                           FontSize="14"
                           Foreground="#757575"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="How are you feeling today?"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#212121"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Mood Buttons / Confirmation -->
            <Grid Grid.Row="2">
                <!-- Status Message (Outside office hours or already submitted) -->
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="20,0,20,10"
                            Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#FFF8E1"
                            CornerRadius="8"
                            Padding="15,10"
                            BorderBrush="#FFE082"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#128337;" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#5D4037"
                                       MaxWidth="320"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Mood Selection -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowMoodButtons, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Happy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource HappyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Happy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128512;" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Happy" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Unhappy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource UnhappyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Unhappy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128528;" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unhappy" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Sad Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource SadBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Sad"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128546;" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sad" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Confirmation Message -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#10004;" FontSize="48" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ConfirmationMessage}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#424242"
                               Margin="20,10,20,0"
                               MaxWidth="350"/>
                </StackPanel>

                <!-- Loading Indicator -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                    <TextBlock Text="Submitting..." FontSize="14" Foreground="#757575" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Offline Indicator -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Background="#FFF3E0"
                        CornerRadius="5"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Offline - Your response will be saved and synced later"
                               FontSize="11"
                               Foreground="#E65100"/>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#FAFAFA" CornerRadius="0,0,15,15">
                <TextBlock Text="{Binding UserInfo}"
                           FontSize="11"
                           Foreground="#9E9E9E"
                           Margin="15,8"
                           HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </Border>
</Window>
