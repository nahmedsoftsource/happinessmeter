<Window x:Class="MoodDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MoodDesktopApp.ViewModels"
        mc:Ignorable="d"
        Title="MoodTrack"
        Height="380" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="15"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#F5F5F5" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="MoodTrack"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#424242"/>

                <Button Grid.Column="1"
                        Content="X"
                        Width="40" Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#757575"
                        FontWeight="Bold"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFCDD2"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Question -->
            <StackPanel Grid.Row="1" Margin="20,20,20,10">
                <TextBlock Text="{Binding Greeting}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#212121"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="How are you feeling?"
                           FontSize="16"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Status Message (Outside office hours or already submitted) -->
            <Border Grid.Row="2"
                    Background="#FFF8E1"
                    CornerRadius="8"
                    Padding="15,10"
                    Margin="30,0,30,15"
                    BorderBrush="#FFE082"
                    BorderThickness="1"
                    Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="&#9200;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#5D4037"/>
                </StackPanel>
            </Border>

            <!-- Mood Buttons / Confirmation -->
            <Grid Grid.Row="3">
                <!-- Mood Selection -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowMoodButtons, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- So Happy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource SoHappyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="SoHappy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128513;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="So Happy" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Very Busy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource VeryBusyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="VeryBusy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128104;&#8205;&#128187;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Very Busy" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Positive Energy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource PositiveEnergyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="PositiveEnergy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#9889;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Positive Energy" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </Button>

                    <!-- Not in Mood Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource NotInMoodBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="NotInMood"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128533;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Not in Mood" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Hungry Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource HungryBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Hungry"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#127828;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hungry" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Grumpy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource GrumpyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Grumpy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#129314;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Grumpy" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sleepy Button -->
                    <Button Style="{StaticResource MoodButtonStyle}"
                            Background="{StaticResource SleepyBrush}"
                            Command="{Binding SelectMoodCommand}"
                            CommandParameter="Sleepy"
                            IsEnabled="{Binding CanSelectMood}">
                        <StackPanel>
                            <TextBlock Text="&#128564;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sleepy" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Confirmation Message -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#10004;" FontSize="48" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ConfirmationMessage}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#424242"
                               Margin="20,10,20,0"
                               MaxWidth="500"/>
                </StackPanel>

                <!-- Loading Indicator -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                    <TextBlock Text="Submitting..." FontSize="14" Foreground="#757575" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Offline Indicator -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Background="#FFF3E0"
                        CornerRadius="5"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Offline - Your response will be saved and synced later"
                               FontSize="11"
                               Foreground="#E65100"/>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="4" Background="#FAFAFA" CornerRadius="0,0,15,15">
                <TextBlock Text="{Binding UserInfo}"
                           FontSize="11"
                           Foreground="#9E9E9E"
                           Margin="15,8"
                           HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </Border>
</Window>
